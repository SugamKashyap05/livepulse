generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model NewsArticle {
  id                 String               @id
  title              String
  description        String?
  link               String               @unique
  pubDate            DateTime
  source             String
  topic              String
  slug               String
  image              String?
  fetchedAt          DateTime             @default(now())
  summary            String?
  sentiment          String?
  aiTags             String?
  aiProcessed        Boolean              @default(false)
  aiGenerated        Boolean              @default(false)
  factScore          Int?
  biasAnalysis       String?
  agentNotes         String?
  published          Boolean              @default(true)
  scored             Boolean              @default(false)
  publishedAt        DateTime?
  scheduledPublishAt DateTime?
  version            Int                  @default(1)
  embeddings         ArticleEmbedding[]
  provenance         ArticleProvenance[]
  contexts           UserArticleContext[]
  events             UserArticleEvent[]
  reads              UserArticleRead[]
  bookmarks          UserBookmark[]

  @@index([topic])
  @@index([slug])
  @@index([fetchedAt])
  @@index([published, pubDate(sort: Desc)])
  @@index([published, publishedAt(sort: Desc)])
  @@index([scheduledPublishAt])
  @@index([version])
  @@index([topic, published, pubDate(sort: Desc)])
  @@index([published, fetchedAt(sort: Desc)])
}

model ArticleEmbedding {
  id             String                @id @default(cuid())
  articleId      String
  chunkIndex     Int
  content        String
  contentHash    String
  embedding      Unsupported("vector")
  embeddingModel String
  embeddingDim   Int
  topic          String
  source         String
  pubDate        DateTime
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  article        NewsArticle           @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, chunkIndex, embeddingModel])
  @@index([articleId])
  @@index([topic])
  @@index([contentHash])
  @@index([embeddingModel])
  @@index([pubDate])
}

model AgentActivity {
  id        String   @id @default(cuid())
  agent     String
  action    String
  targetId  String?
  status    String
  content   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model DailyDigest {
  id           String   @id @default(cuid())
  date         String   @unique
  content      String
  model        String?
  createdAt    DateTime @default(now())
  modelVersion String?
}

model AiLog {
  id               String   @id @default(cuid())
  action           String
  model            String
  prompt           String?
  tokens           Int?
  ms               Int?
  success          Boolean  @default(true)
  error            String?
  createdAt        DateTime @default(now())
  modelVersion     String?
  articleId        String?
  completionTokens Int?
  promptTokens     Int?
  provider         String?
}

model AdminAiJob {
  id                String                 @id @default(cuid())
  type              String
  status            String                 @default("queued")
  title             String
  params            Json
  result            Json?
  error             String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  phase             String?
  progress          Int?
  retryCount        Int                    @default(0)
  maxRetries        Int                    @default(3)
  schemaVersion     String                 @default("1")
  scheduledFor      DateTime?
  cancelledAt       DateTime?
  parentJobId       String?
  modelVersion      String?
  auditLogs         AdminAuditLog[]
  departmentEvents  AdminDepartmentEvent[]
  notifications     AdminNotification[]
  articleProvenance ArticleProvenance[]
  editorContextRefs EditorContextRef[]
  editorMessages    EditorMessage[]
  editorSessions    EditorSession[]
  stateTransitions  JobStateTransition[]
  chatMessages      ManagerChatMessage[]

  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([status])
  @@index([type])
  @@index([type, status])
  @@index([parentJobId])
  @@index([scheduledFor])
  @@index([createdAt])
}

model ArticleProvenance {
  id           String      @id @default(cuid())
  articleId    String
  jobId        String?
  kind         String
  sourceType   String
  sourceName   String?
  sourceUrl    String?
  action       String?
  model        String?
  modelVersion String?
  confidence   Float?
  metadata     Json?
  createdAt    DateTime    @default(now())
  article      NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  job          AdminAiJob? @relation(fields: [jobId], references: [id])

  @@index([articleId])
  @@index([articleId, kind, createdAt])
  @@index([jobId])
  @@index([kind])
  @@index([sourceType])
  @@index([model, modelVersion])
  @@index([createdAt])
}

model AdminNotification {
  id                String                @id @default(cuid())
  type              String
  title             String
  body              String
  status            String                @default("unread")
  jobId             String?
  readAt            DateTime?
  createdAt         DateTime              @default(now())
  department        String?
  severity          String?
  departmentEventId String?
  departmentEvent   AdminDepartmentEvent? @relation(fields: [departmentEventId], references: [id])
  job               AdminAiJob?           @relation(fields: [jobId], references: [id])

  @@index([status, createdAt])
  @@index([status, readAt, createdAt])
  @@index([status])
  @@index([jobId])
  @@index([department, status, createdAt])
  @@index([departmentEventId])
  @@index([createdAt])
  @@index([createdAt(sort: Desc)], map: "AdminNotification_createdAt_desc_idx")
}

model AdminDepartmentEvent {
  id                String              @id @default(cuid())
  department        String
  type              String
  title             String
  body              String
  severity          String              @default("info")
  status            String              @default("unread")
  needsEditorReview Boolean             @default(false)
  jobId             String?
  sourceType        String              @default("manual")
  metadata          Json?
  readAt            DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime            @default(now())
  schemaVersion     String              @default("1")
  auditLogs         AdminAuditLog[]
  job               AdminAiJob?         @relation(fields: [jobId], references: [id])
  notifications     AdminNotification[]
  editorContextRefs EditorContextRef[]

  @@index([department, createdAt])
  @@index([department, status, createdAt])
  @@index([needsEditorReview, status, createdAt])
  @@index([jobId])
  @@index([type])
  @@index([severity])
  @@index([schemaVersion])
  @@index([createdAt])
}

model ManagerChatMessage {
  id        String      @id @default(cuid())
  role      String
  content   String
  metadata  Json?
  jobId     String?
  createdAt DateTime    @default(now())
  job       AdminAiJob? @relation(fields: [jobId], references: [id])

  @@index([createdAt])
  @@index([jobId])
  @@index([jobId, createdAt])
}

model EditorSession {
  id            String             @id @default(cuid())
  title         String
  scope         String             @default("general")
  status        String             @default("active")
  department    String?
  jobId         String?
  articleId     String?
  createdBy     String?
  metadata      Json?
  lastMessageAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  auditLogs     AdminAuditLog[]
  contextRefs   EditorContextRef[]
  messages      EditorMessage[]
  job           AdminAiJob?        @relation(fields: [jobId], references: [id])

  @@index([status, updatedAt])
  @@index([scope, status, updatedAt])
  @@index([department, status, updatedAt])
  @@index([jobId])
  @@index([articleId])
  @@index([lastMessageAt])
  @@index([createdAt])
}

model EditorMessage {
  id        String          @id @default(cuid())
  sessionId String
  role      String
  content   String
  metadata  Json?
  jobId     String?
  createdAt DateTime        @default(now())
  auditLogs AdminAuditLog[]
  job       AdminAiJob?     @relation(fields: [jobId], references: [id])
  session   EditorSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([sessionId, role, createdAt])
  @@index([jobId, createdAt])
  @@index([createdAt])
}

model EditorContextRef {
  id                String                @id @default(cuid())
  sessionId         String
  type              String
  targetId          String
  label             String?
  department        String?
  jobId             String?
  departmentEventId String?
  articleId         String?
  metadata          Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  departmentEvent   AdminDepartmentEvent? @relation(fields: [departmentEventId], references: [id])
  job               AdminAiJob?           @relation(fields: [jobId], references: [id])
  session           EditorSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, type, createdAt])
  @@index([type, targetId])
  @@index([jobId])
  @@index([departmentEventId])
  @@index([articleId])
  @@index([department])
  @@index([createdAt])
}

model AdminAuditLog {
  id                String                @id @default(cuid())
  actorType         String                @default("system")
  actorId           String?
  action            String
  targetType        String
  targetId          String?
  sessionId         String?
  messageId         String?
  jobId             String?
  departmentEventId String?
  before            Json?
  after             Json?
  metadata          Json?
  createdAt         DateTime              @default(now())
  departmentEvent   AdminDepartmentEvent? @relation(fields: [departmentEventId], references: [id])
  job               AdminAiJob?           @relation(fields: [jobId], references: [id])
  message           EditorMessage?        @relation(fields: [messageId], references: [id])
  session           EditorSession?        @relation(fields: [sessionId], references: [id])

  @@index([createdAt])
  @@index([actorType, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([sessionId, createdAt])
  @@index([messageId])
  @@index([jobId, createdAt])
  @@index([departmentEventId, createdAt])
}

model JobStateTransition {
  id         String     @id @default(cuid())
  jobId      String
  fromStatus String?
  toStatus   String
  fromPhase  String?
  toPhase    String?
  event      String
  actorType  String     @default("system")
  actorId    String?
  metadata   Json?
  createdAt  DateTime   @default(now())
  job        AdminAiJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([toStatus, createdAt])
  @@index([event, createdAt])
  @@index([actorType, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model UserProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  country                String?
  region                 String?
  city                   String?
  onboarded              Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  personalizationEnabled Boolean  @default(true)
}

model UserTopicFollow {
  id        String   @id @default(cuid())
  userId    String
  topicSlug String
  createdAt DateTime @default(now())

  @@unique([userId, topicSlug])
  @@index([userId])
}

model UserBookmark {
  id        String      @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime    @default(now())
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
}

model UserArticleRead {
  id        String      @id @default(cuid())
  userId    String
  articleId String
  readAt    DateTime    @default(now())
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, readAt(sort: Desc)])
}

model UserArticleEvent {
  id           String      @id @default(cuid())
  userId       String?
  anonymousId  String?
  articleId    String
  type         String
  value        Float?
  durationMs   Int?
  visibleMs    Int?
  scrollDepth  Float?
  feedScope    String?
  feedPosition Int?
  surface      String?
  source       String?
  sessionId    String?
  pageViewId   String?
  context      Json?
  occurredAt   DateTime    @default(now())
  createdAt    DateTime    @default(now())
  userAgent    String?
  article      NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([anonymousId, occurredAt])
  @@index([articleId, type, occurredAt])
  @@index([articleId, occurredAt])
  @@index([type, occurredAt])
  @@index([sessionId])
  @@index([feedScope, occurredAt])
  @@index([createdAt])
}

model UserArticleContext {
  id              String      @id @default(cuid())
  userId          String
  articleId       String
  impressionCount Int         @default(0)
  clickCount      Int         @default(0)
  readCount       Int         @default(0)
  dwellMs         Int         @default(0)
  maxScrollDepth  Float?
  bookmarked      Boolean     @default(false)
  liked           Boolean     @default(false)
  disliked        Boolean     @default(false)
  hidden          Boolean     @default(false)
  sharedCount     Int         @default(0)
  commentCount    Int         @default(0)
  aiActionCount   Int         @default(0)
  lastSeenAt      DateTime?
  lastClickedAt   DateTime?
  lastEngagedAt   DateTime?
  score           Float       @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  article         NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, score])
  @@index([userId, updatedAt])
  @@index([userId, lastEngagedAt])
  @@index([userId, lastSeenAt])
  @@index([articleId])
}

model UserInterestProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  topicWeights  Json?
  sourceWeights Json?
  tagWeights    Json?
  lastEventAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([lastEventAt])
  @@index([updatedAt])
}

model FeedSource {
  id                   String    @id @default(cuid())
  name                 String    @unique
  url                  String    @unique
  topic                String
  slug                 String
  region               String    @default("global")
  enabled              Boolean   @default(true)
  priority             Int       @default(0)
  lastFetched          DateTime?
  lastStatus           String?
  failCount            Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  fetchIntervalMinutes Int       @default(30)
  lastErrorAt          DateTime?
  lastErrorMessage     String?

  @@index([topic])
  @@index([region])
  @@index([enabled])
  @@index([enabled, lastFetched])
}
